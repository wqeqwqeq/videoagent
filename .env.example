# VideoAgent Environment Variables
# Copy this file to .env and fill in your values

# ======================
# Tableau Configuration
# ======================
TABLEAU_SERVER_URL=https://your-tableau-server.com
TABLEAU_SITE_ID=your-site-id
TABLEAU_WORKBOOK_ID=your-workbook-id

# Authentication Method: "pat" or "username_password"
TABLEAU_AUTH_METHOD=pat

# Personal Access Token (if TABLEAU_AUTH_METHOD=pat)
TABLEAU_PAT_NAME=your-pat-name
TABLEAU_PAT_VALUE=your-pat-value

# Username/Password (if TABLEAU_AUTH_METHOD=username_password)
TABLEAU_USERNAME=your-username
TABLEAU_PASSWORD=your-password


# ======================
# Azure OpenAI Configuration
# (Azure AI Foundry deployment)
# ======================
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-audio-preview
AZURE_OPENAI_API_VERSION=2024-10-21

# ======================
# Application Insights (Optional)
# ======================
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx.in.applicationinsights.azure.com/

# ======================
# Output Configuration (Optional)
# ======================
OUTPUT_BASE_PATH=output

# ======================
# Storage Configuration
# ======================
# Storage mode: "local" or "blob"
STORAGE_MODE=local

# Azure Blob Storage (if STORAGE_MODE=blob)
STORAGE_ACCOUNT_NAME=your-storage-account
STORAGE_CONTAINER=videoagent-output
